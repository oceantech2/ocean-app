{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "proposal.oceantalentsolutions.com" }],
      "destination": "/proposal.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "consultantpanel.oceantalentsolutions.com" }],
      "destination": "/proposal.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "oceantalentsolutions.com" }],
      "destination": "/site.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.oceantalentsolutions.com" }],
      "destination": "/site.html"
    },
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
