# =============================================================================
# Ocean App — envs de deploy (Vercel + Render + Supabase)
# =============================================================================
# Front (Vercel):  https://ocean-app-seven.vercel.app
# Back (Render):   https://ocean-app-backend.onrender.com
#
# DATABASE_URL no Render:
# - NÃO use db.<ref>.supabase.co (só IPv6 → Network is unreachable)
# - Use Session pooler: Supabase → Connect → Session mode → copiar URI
# - Formato:
#   postgresql://postgres.chonzisdsqnsgrjsybor:SENHA@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Supabase ref: chonzisdsqnsgrjsybor
# =============================================================================


# -----------------------------------------------------------------------------
# FRONTEND — Vercel
# -----------------------------------------------------------------------------
# Root Directory: frontend | Build: npm run build | Output: dist

VITE_API_URL=https://ocean-app-backend.onrender.com/api


# -----------------------------------------------------------------------------
# BACKEND — Render (serviço ocean-app-backend)
# -----------------------------------------------------------------------------

DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000

SECRET_KEY=0bcaaec6de966bc9e35a79b8add710f513ec9bce8d9116d6a2eb197af8a21889
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Session pooler (região ca-central-1)
DATABASE_URL=postgresql://postgres.chonzisdsqnsgrjsybor:SENHA@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require

REDIS_URL=redis://localhost:6379

CORS_ORIGINS=https://ocean-app-seven.vercel.app
ALLOWED_HOSTS=ocean-app-backend.onrender.com,localhost,127.0.0.1

UPLOAD_DIR=/app/uploads
UPLOAD_MAX_MB=10
NFS_DIR=/app/nfs-docs
COMPROVANTES_DIR=/app/comprovantes

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@oceanapp.com
ALERT_EMAILS=
ALERT_DIAS_ANTECEDENCIA=5
ALERT_FERIAS_LIMITE_DIAS=20

MAGGO_STUB_FAIL=false


# -----------------------------------------------------------------------------
# CHECKLIST
# -----------------------------------------------------------------------------
# [ ] DATABASE_URL = Session pooler (não Direct / db.*.supabase.co)
# [ ] ALLOWED_HOSTS = ocean-app-backend.onrender.com
# [ ] Vercel: VITE_API_URL = https://ocean-app-backend.onrender.com/api
# [ ] Schemas/migrations no Supabase se public estiver vazio
