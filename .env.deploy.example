# =============================================================================
# Ocean App — envs de deploy (Vercel + Render + Supabase)
# =============================================================================
# Front (Vercel):  https://ocean-app-seven.vercel.app
# Back (Render):   https://ocean-app-backend.onrender.com
#
# DATABASE_URL no Render:
# - NÃO use db.<ref>.supabase.co (só IPv6 → Network is unreachable)
# - Use Session pooler: Supabase → Connect → Session mode → copiar URI
# - Formato:
#   postgresql://postgres.chonzisdsqnsgrjsybor:SENHA@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Supabase ref: chonzisdsqnsgrjsybor
# =============================================================================


# -----------------------------------------------------------------------------
# FRONTEND — Vercel
# -----------------------------------------------------------------------------
# Root Directory: frontend | Build: npm run build | Output: dist

VITE_API_URL=https://ocean-app-backend.onrender.com/api

# Proposal (mesmo projeto Vercel, domínio próprio): base dos links públicos /p/{codigo},
# dos links de convite de fornecedores (/convite) e do item "Proposal" no menu do ERP (/entrar)
# Domínios do projeto: app.oceantalentsolutions.com (ERP) + proposal.oceantalentsolutions.com (Proposal)
VITE_PROPOSAL_PUBLIC_URL=https://proposal.oceantalentsolutions.com

# Consultant Panel (feature 099): painel dos consultores em domínio próprio. Com esta variável,
# proposal.* fica só com a página do cliente (/p/<código>) e o resto redireciona para o painel.
# Só defina depois que o DNS de consultantpanel.* responder (sem ela, nada muda).
VITE_CONSULTANT_PANEL_URL=https://consultantpanel.oceantalentsolutions.com


# -----------------------------------------------------------------------------
# BACKEND — Render (serviço ocean-app-backend)
# -----------------------------------------------------------------------------

DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000

SECRET_KEY=0bcaaec6de966bc9e35a79b8add710f513ec9bce8d9116d6a2eb197af8a21889
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Session pooler (região ca-central-1)
DATABASE_URL=postgresql://postgres.chonzisdsqnsgrjsybor:SENHA@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require

REDIS_URL=redis://localhost:6379

CORS_ORIGINS=https://ocean-app-seven.vercel.app,https://app.oceantalentsolutions.com,https://proposal.oceantalentsolutions.com,https://consultantpanel.oceantalentsolutions.com
ALLOWED_HOSTS=ocean-app-backend.onrender.com,localhost,127.0.0.1

UPLOAD_DIR=/app/uploads
UPLOAD_MAX_MB=10

# Anexos de NF e comprovantes no Supabase Storage (bucket privado "anexos").
# Sem estas duas variáveis os arquivos vão para o disco do Render e somem a cada deploy/reinício.
# Chave: Supabase → Project Settings → API Keys → secret key (ou service_role).
SUPABASE_URL=https://chonzisdsqnsgrjsybor.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=anexos
NFS_DIR=/app/nfs-docs
COMPROVANTES_DIR=/app/comprovantes

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@oceanapp.com
ALERT_EMAILS=
ALERT_DIAS_ANTECEDENCIA=5
ALERT_FERIAS_LIMITE_DIAS=20
# Links dos e-mails de aceite de proposta
PROPOSAL_PUBLIC_URL=https://proposal.oceantalentsolutions.com
# Botão "Abrir no Consultant Panel" do e-mail de aceite (vazio usa PROPOSAL_PUBLIC_URL)
CONSULTANT_PANEL_URL=https://consultantpanel.oceantalentsolutions.com

MAGGO_STUB_FAIL=false


# -----------------------------------------------------------------------------
# CHECKLIST
# -----------------------------------------------------------------------------
# [ ] DATABASE_URL = Session pooler (não Direct / db.*.supabase.co)
# [ ] ALLOWED_HOSTS = ocean-app-backend.onrender.com
# [ ] Render: SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (senão os anexos de NF se perdem)
# [ ] Vercel: VITE_API_URL = https://ocean-app-backend.onrender.com/api
# [ ] Schemas/migrations no Supabase se public estiver vazio
# [ ] Vercel: domínio proposal.oceantalentsolutions.com adicionado ao projeto + CNAME no DNS
# [ ] Vercel: VITE_PROPOSAL_PUBLIC_URL = https://proposal.oceantalentsolutions.com (rebuild)
# [ ] Render: CORS_ORIGINS inclui https://proposal.oceantalentsolutions.com
# [ ] Após o 1º deploy do Proposal: reexecutar backend/scripts/enable_rls_supabase.sql
#     (RLS em propostas e propostas_assinaturas)
# [ ] Consultant Panel (099), nesta ordem:
#     1. DNS: CNAME consultantpanel → Vercel; domínio consultantpanel.oceantalentsolutions.com no projeto
#     2. Render: CORS_ORIGINS inclui https://consultantpanel.oceantalentsolutions.com + CONSULTANT_PANEL_URL
#     3. Vercel: VITE_CONSULTANT_PANEL_URL = https://consultantpanel.oceantalentsolutions.com (rebuild)
# [ ] Render: PROPOSAL_PUBLIC_URL + SMTP_USER/SMTP_PASSWORD/SENDER_EMAIL (e-mails de aceite;
#     sem SMTP os envios só aparecem no log como [email DRY-RUN])
# [ ] Site institucional (100): sem variáveis novas; o rewrite por host já está no vercel.json.
#     Teste: landing.oceantalentsolutions.com
#     1. Vercel: domínio landing.oceantalentsolutions.com no projeto
#     2. DNS (Hostinger): CNAME landing → valor exibido pela Vercel
#     Produção (depois de aprovado; substitui o WordPress atual):
#     3. Vercel: domínios oceantalentsolutions.com e www.oceantalentsolutions.com
#        (um redirecionando para o outro)
#     4. DNS (Hostinger): registro A do domínio raiz e CNAME www com os valores da Vercel;
#        não mexer nos registros MX/TXT (e-mail Google Workspace)
#     5. Conferir que app.*, proposal.* e consultantpanel.* continuam iguais
